# Creating a tuple of student information
student = ("alisha", "Electrical Engineering", 2023, "NUST")

# Print the complete tuple
print(student)

# len() tells us the total number of items
print(len(student))

# Accessing the first item using index 0
print(student[0])

# Accessing the last item using negative indexing
print(student[-1])

# Slicing the tuple
# Index 1 to 3 (index 3 is not included)
print(student[1:3])

# Checking if a value exists in the tuple
print("NUST - Day_6_Tuples:121" in student)

# Counting how many times a value occurs
print(student.count("NUST - Day_6_Tuples:124"))

# Finding the position of a value
print(student.index(2023))

# Tuple unpacking
# Each value is assigned to a separate variable
name, degree, year, university = student

print(name)
print(degree)
print(year)
print(university)