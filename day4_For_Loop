#Find numbers with multiple conditions
for i in range(1, 31):

    if i % 2 == 0 and i % 3 == 0:
        print(i, "Divisible by both 2 and 3")

    elif i % 2 == 0:
        print(i, "Even")

    elif i % 3 == 0:
        print(i, "Divisible by 3")

    else:
        print(i, "Other")
