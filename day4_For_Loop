#for loop with if else conditioning
marks = [85, 72, 91, 48, 63]

for mark in marks:

    if mark >= 90:
        print(mark, "Excellent")

    elif mark >= 80:
        print(mark, "Very Good")

    elif mark >= 60:
        print(mark, "Pass")

    else:
        print(mark, "Fail")
